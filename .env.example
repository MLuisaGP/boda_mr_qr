# Entorno de Produccion / Desarrollo
APP_ENV=local
APP_NAME="Boda Michelle & René"
APP_DATE="2026-12-19"
APP_URL="http://localhost:8000"

# Base de Datos MySQL
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=boda_db
DB_USERNAME=root
DB_PASSWORD=

# Limites de aplicacion
MAX_IMAGE_SIZE_MB=5
MAX_VIDEO_SIZE_MB=30
MAX_VIDEO_DURATION_SEC=20
MAX_ITEMS_PER_GUEST=24
MAX_VIDEOS_PER_GUEST=4
UPLOAD_DIR="uploads"

# Cloudflare R2 (Almacenamiento S3 Compatible - Egress $0)
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
