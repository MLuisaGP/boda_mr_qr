{
    "name": "boda/michelle-y-rene",
    "description": "Plataforma de recuerdos y álbum en vivo para la boda de Michelle & René en HostGator compartido",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "async-aws/s3": "^3.5",
        "illuminate/database": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
